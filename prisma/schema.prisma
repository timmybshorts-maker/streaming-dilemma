generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Card {
  id         String   @id
  statement  String
  image      String
  severity   Int
  attributes String
  createdAt  DateTime @default(now())
}

model Setting {
  key   String @id
  value String
}
